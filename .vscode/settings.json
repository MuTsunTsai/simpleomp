{
	"C_Cpp.autoAddFileAssociations": false,
	"C_Cpp.codeAnalysis.clangTidy.args": [
		"--extra-arg-before=-target",
		"--extra-arg-before=wasm32-unknown-emscripten"
	],
	"C_Cpp.codeAnalysis.clangTidy.checks.disabled": [
		"clang-analyzer-deadcode.DeadStores"
	],
	"C_Cpp.codeAnalysis.clangTidy.enabled": true,
	"C_Cpp.codeAnalysis.clangTidy.headerFilter": "${workspaceFolder}",
	"C_Cpp.loggingLevel": "Debug",
	"cSpell.words": [
		"kmpc"
	],
	"claudeCode.respectGitIgnore": false,
	"files.exclude": {
		"**/obj": true
	},
	"testMate.cpp.discovery.loadOnStartup": true,
	"testMate.cpp.discovery.runtimeLimit": 5,
	"testMate.cpp.log.logpanel": true,
	"testMate.cpp.test.advancedExecutables": [
		{
			"cwd": "${workspaceFolder}/test/build",
			"executableSuffixToInclude": [
				".js"
			],
			"executionWrapper": {
				"args": [
					"${cmd}",
					"${argsFlat}"
				],
				"path": "C:\\Program Files\\nodejs\\node.exe"
			},
			"gtest": {
				"prependTestRunningArgs": [
					"--gtest_color=no"
				]
			},
			"name": "SimpleOMP Tests",
			"pattern": "test/build/test.js"
		}
	]
}